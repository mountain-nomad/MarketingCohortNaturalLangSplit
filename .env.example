# Copy to .env and replace every `change-me-*` value before `make up`.
# .env is gitignored; never commit real secrets.
# Keep values free of spaces, quotes, `$` and `#` (read by both docker compose and make).
# Use URL-safe passwords (letters, digits, - _ . ~): the warehouse password is
# embedded in a connection URL.

# Ports published on 127.0.0.1
APP_PORT=8000
APPDB_PORT=55433
WAREHOUSE_PORT=55432

# Application database (metadata, auth, audit)
APPDB_NAME=cohortsplit
APPDB_USER=cohortsplit
APPDB_PASSWORD=change-me-appdb

# Demo warehouse (PostgreSQL `ecommerce` sample)
# Bootstrap superuser, used only by the container's init scripts.
WAREHOUSE_ADMIN_PASSWORD=change-me-warehouse-admin
# Read-only role `cohortsplit_ro` the application uses.
WAREHOUSE_RO_PASSWORD=change-me-warehouse-ro

LOG_LEVEL=INFO
